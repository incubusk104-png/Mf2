package com.rork.mindsetframestracker.notifications

import android.content.Context
import android.content.Intent
import android.net.Uri
import android.os.Build
import android.os.PowerManager
import android.provider.Settings
import android.util.Log

/**
 * Requests exemption from battery optimization for this app.
 *
 * Root cause this fixes: [HabitAlarmScheduler] already uses
 * setExactAndAllowWhileIdle with SCHEDULE_EXACT_ALARM/USE_EXACT_ALARM, which
 * is correct — but on MIUI (Xiaomi), Samsung, Oppo/Vivo (ColorOS/FuntouchOS),
 * and Honor, the OS's own battery manager can still silently kill or delay
 * a scheduled alarm broadcast if the app isn't whitelisted from battery
 * optimization, REGARDLESS of exact-alarm permission. This is the single
 * most common cause of "the alarm just didn't ring" reports on real devices
 * (as opposed to emulators, which don't apply these restrictions).
 *
 * The standard AlarmManager alarm scheduling is unaffected/unchanged by
 * this — this only stops the OS from deprioritizing the app's process so
 * the alarm broadcast can actually reach HabitAlarmReceiver on time.
 */
object BatteryOptimizationHelper {

    private const val TAG = "BatteryOptimization"

    /** True when the OS is already NOT restricting this app's background activity. */
    fun isIgnoringBatteryOptimizations(context: Context): Boolean {
        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.M) return true
        val pm = context.getSystemService(Context.POWER_SERVICE) as PowerManager
        return runCatching {
            pm.isIgnoringBatteryOptimizations(context.packageName)
        }.getOrDefault(false)
    }

    /**
     * Launches the system dialog asking the user to exempt this app from
     * battery optimization. This is the same one-tap dialog "allow"/"deny"
     * dialog other alarm/reminder apps use — no special permission needed
     * beyond the manifest entry, and it isn't Play/AppGallery Store policy
     * restricted for genuine alarm-reminder functionality.
     *
     * Falls back to opening the general battery-optimization settings list
     * if the direct-request intent isn't handled by this device/ROM.
     */
    fun requestExemption(context: Context) {
        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.M) return
        if (isIgnoringBatteryOptimizations(context)) return

        val direct = Intent(Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS).apply {
            data = Uri.parse("package:${context.packageName}")
        }
        val launched = runCatching {
            context.startActivity(direct)
            true
        }.getOrElse {
            Log.w(TAG, "Direct battery exemption intent failed: ${it.message}")
            false
        }
        if (launched) return

        // Fallback: open the general list so the user can find this app manually.
        runCatching {
            context.startActivity(Intent(Settings.ACTION_IGNORE_BATTERY_OPTIMIZATION_SETTINGS))
        }.onFailure {
            Log.e(TAG, "Could not open battery optimization settings at all: ${it.message}")
        }
    }
}
