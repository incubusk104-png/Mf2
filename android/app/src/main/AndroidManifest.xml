<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- androidx.health.connect:connect-client declares minSdk 26 in its own
         manifest, but this app supports minSdk 24. The override below lets the
         manifest merge succeed; MindsetHealthConnectClient (integrations/HealthConnectClient.kt)
         guards every entry point behind Build.VERSION.SDK_INT >= 26, so the
         library is never actually touched on API 24/25 devices. -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Google Health Connect: the OS-level permission grant screen for a
         given HealthPermission (StepsRecord / SleepSessionRecord read access)
         will only show that item — or grant anything at all — if the app has
         ALSO declared the matching android.permission.health.* manifest
         permission below. Without these two lines, PermissionController's
         request activity opens with nothing it's allowed to show and
         immediately finishes with an empty granted set: that's the
         "permissions were not granted" result even though the user never
         actually saw a dialog to approve or deny. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Offline detection for cloud backup — lets the app queue syncs instead of failing. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-schedule the daily reminder alarm after a device reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Habit reminders fire at an exact time. On Android 12 (API 31/32) this
         permission is granted automatically, so the alarms are exact there
         without a prompt. On Android 13+ (API 33+) it is user-controllable; the
         scheduler checks AlarmManager.canScheduleExactAlarms() at runtime and
         falls back to an inexact windowed alarm when it isn't granted, so the
         app never crashes and reminders still fire. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Lets the app show the one-tap "exempt from battery optimization"
         dialog. Without this, exact/windowed alarms can still be silently
         killed on MIUI (Xiaomi), Samsung, Oppo/Vivo, and Honor even with
         SCHEDULE_EXACT_ALARM granted — this is the most common real-device
         cause of "the alarm just didn't ring" reports. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- USE_EXACT_ALARM is auto-granted on API 33+ for alarm/reminder apps.
         Unlike SCHEDULE_EXACT_ALARM it doesn't require the user to visit
         Settings > Alarms & Reminders. Both are declared so the scheduler
         can use whichever is available. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Vibration for habit reminder notifications. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Needed for usage stats tracking features -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Needed only on Android 9 and below to save the shared progress image to the gallery.
         Android 10+ uses scoped MediaStore inserts, which require no permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Required on targetSdk 30+: Android's package-visibility filtering
         hides other apps' package info by default. Without declaring HMS
         Core here, HuaweiApiAvailability.isHuaweiMobileServicesAvailable()
         can't see HMS Core is installed even when it genuinely is, and
         always reports SERVICE_MISSING (code 1) — this is what was
         blocking Huawei sign-in on devices that DO have HMS Core.

         com.huawei.health is the Huawei Health app that Health Kit
         launches for user authorization (step-read consent screen).
         Without it here, the Health Kit authorization intent may fail
         to resolve on Android 11+ devices. -->
    <queries>
        <package android:name="com.huawei.hwid" />
        <package android:name="com.huawei.appmarket" />
        <package android:name="com.huawei.health" />
        <intent>
            <action android:name="com.huawei.hms.core.aidlservice" />
        </intent>

        <!-- Google Health Connect (Android 14+: platform module; older: standalone APK).
             Without these entries, HealthConnectClient.getSdkStatus() cannot see the
             Health Connect provider behind Android 11+ package-visibility filtering
             and silently returns SDK_UNAVAILABLE — blocking the entire permission
             flow even when Health Connect IS installed. The intent declaration lets
             PermissionController.createRequestPermissionResultContract() resolve the
             Health Connect permissions activity. -->
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        tools:replace="android:allowBackup"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Mindset Frames"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.MindsetFrames">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MindsetFrames">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Return leg of the email auth web-bridge: mindsetframes.online
                 forwards Supabase confirmation results to
                 com.mindsetframes.habittracker://auth-callback. singleTask
                 reuses the running activity (no duplicate instances or login
                 loops); MainActivity consumes each link exactly once. The
                 legacy scheme stays registered for older links. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.mindsetframes.habittracker"
                    android:host="auth-callback" />
                <data
                    android:scheme="com.rork.mindsetframestracker"
                    android:host="auth-callback" />
            </intent-filter>
            <!-- Strava OAuth return leg: the browser redirects to
                 mindsetframes://strava-callback?code=... after the athlete
                 approves access. StravaAuthClient.REDIRECT_URI must match. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="mindsetframes"
                    android:host="strava-callback" />
            </intent-filter>

            <!-- Polar AccessLink OAuth return leg: the browser redirects to
                 mindsetframes://polar-callback?code=... after the user
                 authorises activity data access. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="mindsetframes"
                    android:host="polar-callback" />
            </intent-filter>

            <!-- Google Health Connect REQUIREMENT (Android 13 and below):
                 Health Connect only shows this app in its permission dialog
                 when the app declares an activity that handles the
                 privacy-policy rationale intent. WITHOUT this intent-filter
                 the permission request activity opens and immediately returns
                 an EMPTY granted set — the exact "Health Connect permissions
                 were not granted" failure, even though the user never saw a
                 dialog to approve. MainActivity handles the intent (it simply
                 opens; the in-app privacy policy is available from Settings). -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Google Health Connect REQUIREMENT (Android 14+, API 34+):
             on Android 14 the rationale intent moved to the platform action
             android.intent.action.VIEW_PERMISSION_USAGE with the
             HEALTH_PERMISSIONS category, delivered through a permission-
             protected alias. Without this alias, permission requests on
             Android 14+ devices are silently rejected with an empty grant
             set — same symptom as above but only on newer phones. -->
        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".util.CopySummaryReceiver"
            android:exported="false" />

        <receiver
            android:name=".notifications.CheckInReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.rork.mindsetframestracker.DAILY_CHECK_IN" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".notifications.StreakAlertReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.rork.mindsetframestracker.STREAK_ALERT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".notifications.WeeklyRecapReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.rork.mindsetframestracker.WEEKLY_RECAP" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".notifications.CompanionReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.rork.mindsetframestracker.TRIAL_PAYMENT_REMINDER" />
                <action android:name="com.rork.mindsetframestracker.EVENING_REFLECTION" />
            </intent-filter>
        </receiver>

        <!-- Added HabitAlarmReceiver for individual habit notification alarms -->
        <receiver
            android:name=".notifications.HabitAlarmReceiver"
            android:exported="false"
            android:enabled="true" />

        <!-- Handles "Snooze 5 min" tapped on a habit reminder notification -->
        <receiver
            android:name=".notifications.HabitSnoozeReceiver"
            android:exported="false"
            android:enabled="true" />

        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
