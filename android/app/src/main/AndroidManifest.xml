<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Alarms must survive doze + app standby so they fire at the exact minute. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Re-arm every alarm after a reboot or an app update (BootReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- So a ringing alarm can wake the screen and show the lock-screen dialog. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Requested but optional: a user who declines still gets every alarm, since
         AlarmScheduler falls back to setWindow(15 min) when exact alarms are not
         granted. Asking lets the permission prompt offer the grant in one tap,
         and keeps canScheduleExactAlarms() meaningful on Android 12+. -->
    <uses-permission android:name="android.permission.REQUEST_SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".MindsetFramesApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Alarm ringing screens ────────────────────────────────────────
             Two screens, deliberately: the per-habit dialog asks a question
             (Done / Snooze / Skip) so it needs the answer to be unambiguous,
             while the generic ringing screen is a plain "this is ringing, stop
             it" screen used by timers and by habit rings that have already been
             answered today. Both are hosted from a full-screen intent, so both
             must be wake-and-show capable; both are excluded from recents so a
             ringing alarm cannot be re-opened later as a stale dialog. -->
        <activity
            android:name=".notifications.AlarmRingingActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.MindsetFrames.Alarm" />

        <activity
            android:name=".notifications.HabitAlarmDialogActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.MindsetFrames.Alarm" />

        <!-- ── Notification-scheduled receivers ───────────────────────────── -->
        <receiver
            android:name=".notifications.DailyReminderReceiver"
            android:exported="false"
            android:enabled="true" />

        <receiver
            android:name=".notifications.StreakAlertReceiver"
            android:exported="false"
            android:enabled="true" />

        <receiver
            android:name=".notifications.WeeklyRecapReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.rork.mindsetframestracker.WEEKLY_RECAP" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".notifications.CompanionReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.rork.mindsetframestracker.TRIAL_PAYMENT_REMINDER" />
                <action android:name="com.rork.mindsetframestracker.EVENING_REFLECTION" />
            </intent-filter>
        </receiver>

        <!-- Fired by the AlarmManager alarm-clock alarm that HabitAlarmScheduler
             schedules for each habit's reminder time (and by the snooze re-fire
             below). -->
        <receiver
            android:name=".notifications.HabitReminderReceiver"
            android:exported="false"
            android:enabled="true" />

        <!-- Handles "Snooze 5 min" tapped on a habit reminder notification -->
        <receiver
            android:name=".notifications.HabitSnoozeReceiver"
            android:exported="false"
            android:enabled="true" />

        <!-- Turns the lock-screen habit dialog's Done / Snooze / Skip answers
             into state.

             Deliberately has NO <intent-filter>. The answer buttons address the
             receiver directly by class
             (`Intent(context, AlarmRingActionReceiver::class.java)`), so the
             three action constants are the dispatch identity and never need to
             be advertised. An intent-filter here buys nothing, and it is dead
             surface that would become a vulnerability the moment anyone flipped
             exported to "true": an exported receiver matching HABIT_DONE would
             let any other app mark the user's habits done, snooze their alarms,
             or dismiss them. Kept exported="false" and explicit-only. -->
        <receiver
            android:name=".notifications.AlarmRingActionReceiver"
            android:exported="false"
            android:enabled="true" />

        <!-- Handles the manual "Stop alarm" action on a ringing alarm's
             notification (and on the ongoing "Alarm ringing" notification).
             A broadcast rather than a service start on purpose: a notification
             action that starts a service can be silently refused under the
             Android 12+ background-start restrictions, which would leave the user
             pressing a button that does nothing while the alarm keeps ringing.
             Not exported — only our own notification actions send it. -->
        <receiver
            android:name=".notifications.AlarmStopReceiver"
            android:exported="false"
            android:enabled="true" />

        <!-- ── Timer / stopwatch ────────────────────────────────────────────
             The service keeps a running timer visible (ongoing notification with
             the live remaining time) and is the in-process safety net that rings
             the completion alert if the AlarmManager path is blocked by an OEM
             force-stop. It is started ONLY while a timer actually runs and stops
             itself the moment the timer pauses, finishes or is cleared. -->
        <service
            android:name=".notifications.TimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a user-started timer or stopwatch running and shows its remaining time until the user stops it." />
        </service>

        <!-- ── The alarm sound ──────────────────────────────────────────────
             Owns the actual RING (MediaPlayer on the ALARM stream + looping
             vibration) for every alarm in the app. Started from the
             notification path — HabitCheckInNotifier / TimerNotifier — so the
             sound does not depend on AlarmRingingActivity being granted
             full-screen-intent access. On Android 14+ that grant is revoked by
             default for non-alarm apps, which is exactly why the reminder
             could appear with no sound. -->
        <service
            android:name=".notifications.AlarmRingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Fired by the AlarmManager alarm armed for a running timer's exact
             deadline. This is the wake-up that must survive Doze. -->
        <receiver
            android:name=".notifications.TimerAlarmReceiver"
            android:exported="false"
            android:enabled="true" />

        <!-- One-shot follow-up: nudges once, and only once, when a completed
             timer's result was never opened. -->
        <receiver
            android:name=".notifications.TimerReminderReceiver"
            android:exported="false"
            android:enabled="true" />

        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="false"
            android:enabled="true">
            <!-- BOOT_COMPLETED / MY_PACKAGE_REPLACED: AlarmManager alarms do not
                 survive either event, so every alarm is re-armed here.

                 TIME_SET / TIMEZONE_CHANGED: every alarm is armed as an ABSOLUTE
                 RTC_WAKEUP epoch computed from a local wall-clock time, so
                 changing the clock or moving timezone leaves the stored epoch
                 pointing at the wrong local time — the reminder fires hours off
                 or is dropped entirely by HabitRepeat's "already past" check.
                 Re-arming recomputes each epoch from the new zone (see
                 BootReceiver).

                 All four are system/protected broadcasts, so exported="false"
                 keeps the receiver closed to other apps without blocking them. -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
